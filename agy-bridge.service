[Unit]
Description=agy ACP bridge (OpenAI-compatible surface over Antigravity CLI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/agy-bridge
Environment=AGY_BRIDGE_BIND=0.0.0.0
Environment=AGY_ADMIN_TOKEN=CHANGE_ME
Environment=AGY_WORKERS_PER_PROFILE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /root/agy-bridge/bridge.py
Restart=always
RestartSec=3
StandardOutput=append:/var/log/agy-bridge.log
StandardError=append:/var/log/agy-bridge.log

[Install]
WantedBy=multi-user.target
